; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="八荒湮隳"
config/description="被师徒一行人打败的各大魔头又受到神秘力量的侵蚀重返三界，浩劫之际，天崩地裂，能否再次斩妖除魔，歼灭罪魁祸首……"
run/main_scene="res://Scene/Main_menu/Main_Menu.tscn"
config/use_hidden_project_data_directory=false
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0.141176, 0.141176, 0.141176, 0)
boot_splash/image="res://Art/MainGame/Loading.png"
config/icon="uid://cnxoidb824we1"
config/windows_native_icon="res://Art/MainGame/icon.ico"

[autoload]

Global="*res://Global.gd"
BaseHit="*res://BaseHit.gd"
RoleProp="*res://Script/Base/BaseRoleProperies.gd"
AddEffect="*res://Script/Base/BaseAddEffect.gd"
PlayerData="*res://Script/MemoryClass/PlayerData.gd"
MemoryClass="*res://Script/MemoryClass/MemoryClass.gd"
MainSet="*res://Script/MemoryClass/main_set.gd"
AE="*res://AllEquipment.gd"
MLdl="*res://Script/LDL/Main_ldl.gd"
PaSkill="*res://Passive_Skills.gd"
MgW="*res://MagicWeapon.gd"
PoolManager="*res://PoolManager.gd"
BuffInfomation="*res://BuffInfo.gd"
Ck="*res://CK.gd"
MainMusic="*res://MainMusic.gd"
Signals="*res://Signals.gd"

[display]

window/size/viewport_width=940
window/size/viewport_height=590
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="res://Art/MainGame/sbgb.png"

[editor]

movie_writer/disable_vsync=true
movie_writer/fps=30

[editor_plugins]

enabled=PackedStringArray("res://addons/AS2P/plugin.cfg", "res://addons/codeandweb.texturepacker/plugin.cfg")

[global_group]

Role_Interactive="玩家交互的"

