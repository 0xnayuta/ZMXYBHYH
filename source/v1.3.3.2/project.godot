[input_devices]

compatibility/legacy_just_pressed_behavior=true
pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[layer_names]

2d_physics/layer_1="环境"
2d_physics/layer_2="角色"
2d_physics/layer_3="怪物"
2d_physics/layer_4="吸血"
2d_physics/layer_5="出口"
2d_physics/layer_6="台阶"
2d_physics/layer_7="火魔斩检测范围"
2d_physics/layer_8="怪物攻击范围检测玩家受伤范围，蝙蝠吸血"
2d_physics/layer_9="陷阱"
2d_physics/layer_10="陷阱检测"
2d_physics/layer_11="法宝"
2d_physics/layer_12="角色攻击检测怪物受伤（）"
2d_physics/layer_13="蝙蝠石像检测陷阱"

[rendering]

textures/canvas_textures/default_texture_filter=2
renderer/rendering_method.web="forward_plus"
textures/vram_compression/import_etc2_astc=true
