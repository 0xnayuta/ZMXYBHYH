# ==========================================
# 原始大文件与标靶二进制（严格不入库）
# ==========================================
/binaries/
*.exe
*.dll
*.so
*.dylib
*.pck
*.apk
*.aab
*.ipa
*.msi
*.dmg
*.app

# ==========================================
# 逆向中间产物与解密沙盒
# ==========================================
/extracted/
/tools/analysis_*/
/tools/analysis/
/tools/converted_scenes/
/tools/test_out/
*.tmp
*.bin

# ==========================================
# 外部独立逆向工具（建议通过文档/脚本外置下载）
# ==========================================
/tools/gdre/

# ==========================================
# Godot 4+ 核心项目缓存与构建目录 (遵循官方标准)
# ==========================================
.godot/
godot/
.import/
.nomedia
/build/
android/build/
.gradle/

# ==========================================
# Godot 4+ 引擎单体导入缓存与二进制衍生文件
# 注：Font/Art 源代码必须保留源格式，编译生成的流式缓存严禁入库
# ==========================================
*.fontdata
*.ctex
*.stex
*.sample
*.mp3str
*.oggstr
*.translation

# ==========================================
# Godot 4.2+ / 4.4+ / 4.7 伴生临时文件与热重载
# ==========================================
*.uid
~*.dll
~*.so

# ==========================================
# 导出凭据与敏感配置文件
# ==========================================
export_credentials.cfg
export.cfg

# ==========================================
# C# / .NET / Mono 支持 (若未来引入)
# ==========================================
.mono/
data_*/
mono_crash.*.json
*.csproj.old
*.sln.old

# ==========================================
# Python 运行、调试与备份文件
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.log
*.bak
*.orig
*.swp

# ==========================================
# 操作系统与 IDE 配置
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.user
